# Simulation outputs
# Navigate renders figures and writes reports into plots*/ folders (plots,
# plots_analysis, plots_debug, ...) inside each run directory. These rules are
# scoped to the run trees so the source package navigate/output/plots/
# stays tracked.
/simulations/**/plots*/
/simulations/examples/**/*.png
/simulations/examples/**/*.pkl
/simulations/examples/**/*.xlsx

/simulations/scenarios/**/*.png
/simulations/scenarios/**/*.pkl
/simulations/scenarios/**/*.xlsx
/simulations/scenarios/debug_plots/

/simulations/debug/*
!/simulations/debug/.gitkeep

# Tutorial outputs (keep _static assets)
/tutorials/**/plots*/
/tutorials/**/*.png
/tutorials/**/*.pkl
/tutorials/**/*.prt
/tutorials/**/*.xlsx
!/tutorials/_static/**

# Test outputs
/tests/**/plots*/
/tests/**/*.png
/tests/**/*.pkl
/tests/**/*.xlsx
/tests/**/output/
