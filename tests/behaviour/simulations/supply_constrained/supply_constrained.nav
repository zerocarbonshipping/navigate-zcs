# ------------------------------------------------------------------------------
# BEHAVIOUR DECK: SUPPLY CONSTRAINED (base of the supply pair)
#
# A GHG-intensity regulation imposes e-ammonia demand on a single oil/ammonia
# fleet while the Producer's MaximumDevelopment keeps supply behind that demand
# for the whole horizon.
#
# The assertions live in tests/behaviour/test_response_direction.py.
# ------------------------------------------------------------------------------

DEFINE {
	Load DefaultModelDefinition

	Include "../0_includes/options.inc"
	Include "../0_includes/fleet_oil_ammonia.inc"
	Include "../0_includes/fleet_calibration.inc"
	Include "../0_includes/ports_oil_ammonia.inc"
	Include "../0_includes/fuel_supply_ammonia.inc"
	Include "../0_includes/regulation_intensity.inc"

	Load DefaultEmission

	# plots for manual deck inspection (run the deck without -s);
	# tests suppress plot generation to stay fast
	Load DefaultPlot
	Load DebugPlot
}

EVENTS {
	Load DefaultTimeStepYearly
}
