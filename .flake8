[flake8]
max-line-length = 128

exclude =
    __pycache__,
    build,
    dist,
    .venv,
    venv,
    .idea,
    migrations,
    .claude,
    .git

ignore = B023, E731, E241, W503

per-file-ignores =
    __init__.py: F401
    navigate/bunker/solver.py: N802, N811, N816
    navigate/bunker/solver_highs.py: N802, N806
    tests/unit/test_bunker_build.py: N802

extend-select = B,N
