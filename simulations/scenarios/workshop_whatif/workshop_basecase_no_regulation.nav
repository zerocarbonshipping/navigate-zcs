# The no-regulation basecase on the workshop's coarse timeline. Identical to
# simulations/scenarios/basecase_no_regulation/ except for the time step, so its
# numbers are NOT comparable with that deck - see
# docs/workshop/05-build-your-own-whatif.ipynb.

DEFINE {
	Load DefaultModelDefinition
    Load DefaultBunkerLogistics

    # fleets
    Load DefaultFleet

    # voyages
    Load DefaultPort

    # fuels
    Load DefaultEmission
    Load DefaultFeedstock
    Load DefaultFuel
    Load DefaultProducer
    Load DefaultPlant
    Load DefaultRegion
    Load DefaultSource
    Load DefaultTransport


    # calibration
    Load DefaultCalibration

	# output
    Load DefaultReport
    Load DefaultPlot
	Load DebugPlot
}

EVENTS {
	Load DefaultConverterAvailable
	Include "./includes/time_steps_coarse.inc"
}
