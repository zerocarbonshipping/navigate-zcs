# EXAMPLE 4 - Panamax fleet, Chile to Rotterdam, with Session 1's levers as
# %NAME% placeholders: run it with navigate --set NAME=VALUE, or through
# Horizon with levers.hor.

DEFINE {
    Load DefaultModelDefinition

    # ---- fleet ----
    Include "includes/fleet.inc"

    # ---- route ----
    Include "includes/route.inc"
    Include "includes/ports.inc"

    # ---- fuel ----
    Load DefaultSource
    Load DefaultTransport
    Include "includes/fuel_production.inc"
    Include "includes/regions.inc"
    Include "includes/producer.inc"
    Include "includes/fuel_delivery.inc"
    Load DefaultEmission

    # ---- regulation ----
    Include "includes/eu_ets.inc"
    Include "includes/fuel_eu.inc"

    # ---- behavioural traits ----
    Load DefaultCalibration

    # ---- levers ----
    # the four switches, 0 or 1, each pick a file: Jurisdiction and
    # set_include_vessel take only ports and TRUE/FALSE
    Include "includes/eu_rules_whole_voyage_%EU_RULES_WHOLE_VOYAGE%.inc"
    Include "includes/freeze_efficiency_%FREEZE_EFFICIENCY%.inc"
    Include "includes/no_fueleu_%NO_FUELEU%.inc"
    Include "includes/no_eu_ets_%NO_EU_ETS%.inc"
    Include "includes/levers.inc"
}

EVENTS {
    Load DefaultTimeStepYearly
}
