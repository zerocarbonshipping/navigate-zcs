# LEVERS - the Horizon study STEP 4 of notebook 1 runs, of example_4.unc over
# Session 1's levers. Each parameter fills the %NAME% of the same name in
# example_4.unc and includes/levers.inc, as --set does in STEP 3.
#
# A lever with active = TRUE is drawn from its range: lowest, most likely and
# highest, as multipliers on what the deck says, on a log scale for
# LOG-TRIANGULAR. With active = FALSE it stays at its most likely value, 1.0,
# the reference. The ranges are the suggested spans of STEP 3.
#
# Sample 1 takes every lever at its most likely value, sample 2 at the end that
# lowers emissions (the highest where emissions_low = MAXIMUM, else the lowest)
# and sample 3 at the other end; the rest are a Latin hypercube.

ContinuousParameter "OIL_PRICE"                 = TRIANGULAR(0.7, 1.0, 2.0)      { active = TRUE,  emissions_low = MAXIMUM }
ContinuousParameter "LNG_PRICE"                 = TRIANGULAR(0.7, 1.0, 1.6)      { active = FALSE, emissions_low = MAXIMUM }
ContinuousParameter "EU_ETS_PRICE"              = TRIANGULAR(0.5, 1.0, 3.0)      { active = FALSE, emissions_low = MAXIMUM }
ContinuousParameter "FUELEU_TARGET"             = TRIANGULAR(0.3, 1.0, 1.2)      { active = FALSE }
ContinuousParameter "FUELEU_PENALTY"            = TRIANGULAR(1.0, 1.0, 5.0)      { active = FALSE, emissions_low = MAXIMUM }
ContinuousParameter "CHILE_ELECTRICITY_PRICE"   = TRIANGULAR(0.6, 1.0, 1.4)      { active = FALSE }
ContinuousParameter "EUROPE_ELECTRICITY_PRICE"  = TRIANGULAR(0.6, 1.0, 1.4)      { active = FALSE }
ContinuousParameter "BIOMASS_AVAILABILITY"      = LOG-TRIANGULAR(0.1, 1.0, 10.0) { active = FALSE, emissions_low = MAXIMUM }
ContinuousParameter "BIOGENIC_CO2_AVAILABILITY" = TRIANGULAR(0.5, 1.0, 2.0)      { active = FALSE, emissions_low = MAXIMUM }
ContinuousParameter "TRADE_GROWTH"              = TRIANGULAR(0.0, 1.0, 2.0)      { active = FALSE }

# The four switches of STEP 3: every run of the study uses the default;
# active = TRUE runs the whole study once for each value.
ScenarioParameter "EU_RULES_WHOLE_VOYAGE" { values = ["0", "1"], default = "0", active = FALSE }  # 1: San Antonio inside both schemes
ScenarioParameter "FREEZE_EFFICIENCY"     { values = ["0", "1"], default = "0", active = FALSE }  # 1: nothing further gets fitted
ScenarioParameter "NO_FUELEU"             { values = ["0", "1"], default = "0", active = FALSE }  # 1: FuelEU taken out; EU ETS stays
ScenarioParameter "NO_EU_ETS"             { values = ["0", "1"], default = "0", active = FALSE }  # 1: EU ETS taken out; FuelEU stays

Horizon {
    UncFilePath = "example_4.unc"  # the deck
    OutputPath = "study"           # the folder of the study's runs and results
    NumberOfSamples = 15           # number of simulations
    SamplingMethod = LHS
    RandomSeed = 42
}
