# BASECASE_STRONG_REGULATION - simulations/scenarios/basecase_strong_regulation,
# on the coarse grid (--set GRID=coarse) or year by year (--set GRID=yearly).

DEFINE {
    Load DefaultModelDefinition

    # fleets
    Load DefaultFleet

    # voyages
    Load DefaultPort

    # fuels
    Load DefaultEmission
    Load DefaultFeedstock
    Load DefaultFuel
    Load DefaultProducer
    Load DefaultPlant
    Load DefaultRegion
    Load DefaultSource
    Load DefaultTransport

    # regulations
    Load DefaultRegulation
    Include "includes/strong_regulation.inc"

    # calibration
    Load DefaultCalibration
}

EVENTS {
    Load DefaultConverterAvailable
    Include "includes/time_steps_%GRID%.inc"
}
