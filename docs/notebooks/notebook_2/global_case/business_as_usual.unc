# BUSINESS_AS_USUAL - simulations/scenarios/business_as_usual, on the coarse grid
# (--set GRID=coarse) or year by year (--set GRID=yearly), with Session 2's
# levers as %NAME% placeholders: every multiplier and switch at 1 gives the
# scenario itself.

DEFINE {
    Load DefaultModelDefinition

    # fleets
    Load DefaultFleetInternational
    Load DefaultFleetDomestic

    # voyages
    Load DefaultPort
    Load DefaultVoyageInternational
    Load DefaultVoyageDomestic

    # fuels
    Load DefaultEmission
    Load DefaultFeedstock
    Load DefaultFuel
    Load DefaultProducer
    Load DefaultPlant
    Load DefaultRegion
    Load DefaultSource
    Load DefaultTransport

    # regulations
    Load DefaultRegulation

    # calibration
    Load DefaultCalibration

    # levers
    Include "includes/levers.inc"
    Include "includes/eu_levers.inc"

    # switches: 0 or 1 picks a file
    Include "includes/eu_ets_%EU_ETS%.inc"
    Include "includes/fuel_eu_%FUELEU%.inc"
    Include "includes/eu_worldwide_%EU_WORLDWIDE%.inc"
}

EVENTS {
    Load DefaultConverterAvailable
    Include "includes/time_steps_%GRID%.inc"
}
