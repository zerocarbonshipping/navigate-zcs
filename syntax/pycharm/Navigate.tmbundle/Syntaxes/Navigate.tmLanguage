<plist version="1.0">
    <dict>
        <key>name</key>
        <string>Navigate</string>
        <key>scopeName</key>
        <string>source.navigate</string>
        <key>fileTypes</key>
        <array>
            <string>nav</string>
            <string>inc</string>
            <string>unc</string>
        </array>
        <key>patterns</key>
        <array>
            <dict>
                <key>match</key>
                <string>#.*</string>
                <key>name</key>
                <string>comment.line.navigate</string>
            </dict>
            <dict>
                <key>match</key>
                <string>\b(DEFINE|EVENTS|Include|Load|Start|End|Date|Import|Copy|ModelDefinition|BunkerOptions|Converter|Curve|Emission|Feedstock|Fleet|Forecast|Fuel|Levy|Plant|Plot|Port|PowerSystem|Process|Producer|Region|Regulation|Report|Route|Source|Surface|Tank|Technology|Timetable|Transport|Variable|Vessel)\b</string>
                <key>name</key>
                <string>keyword.control.navigate</string>
            </dict>
            <dict>
                <key>match</key>
                <string>\b(Table|Array)\b</string>
                <key>name</key>
                <string>keyword.other.navigate</string>
            </dict>
            <dict>
                <key>match</key>
                <string>\b\d+\b</string>
                <key>name</key>
                <string>constant.numeric.navigate</string>
            </dict>
            <dict>
                <key>match</key>
                <string>[{}]</string>
                <key>name</key>
                <string>punctuation.section.braces.navigate</string>
            </dict>
            <dict>
                <key>match</key>
                <string>\(|\)</string>
                <key>name</key>
                <string>punctuation.section.parens.navigate</string>
            </dict>
            <dict>
                <key>match</key>
                <string>=</string>
                <key>name</key>
                <string>keyword.operator.assignment.navigate</string>
            </dict>
            <dict>
                <key>match</key>
                <string>("([^"]*)"|'([^']*)')</string>
                <key>name</key>
                <string>string.quoted.navigate</string>
            </dict>
        </array>
    </dict>
</plist>
