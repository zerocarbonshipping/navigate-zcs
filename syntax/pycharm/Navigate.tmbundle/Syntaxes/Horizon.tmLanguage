<plist version="1.0">
    <dict>
        <key>name</key>
        <string>Horizon</string>
        <key>scopeName</key>
        <string>source.horizon</string>
        <key>fileTypes</key>
        <array>
            <string>hor</string>
        </array>
        <key>patterns</key>
        <array>
            <dict>
                <key>match</key>
                <string>#.*</string>
                <key>name</key>
                <string>comment.line.horizon</string>
            </dict>
            <dict>
                <key>match</key>
                <string>("[^"]*"|'[^']*')</string>
                <key>name</key>
                <string>string.quoted.horizon</string>
            </dict>
            <dict>
                <key>match</key>
                <string>\b\d+(?:\.\d+)?(?:[eE][+-]?\d+)?\b</string>
                <key>name</key>
                <string>constant.numeric.horizon</string>
            </dict>
            <dict>
                <key>match</key>
                <string>(?&lt;![\w-])(?:if|in|and|Include|Exclude)(?![\w-])</string>
                <key>name</key>
                <string>keyword.control.horizon</string>
            </dict>
            <dict>
                <key>match</key>
                <string>(?&lt;![\w-])(?:ScenarioParameter|ContinuousParameter|DiscreteParameter|Horizon)(?![\w-])</string>
                <key>name</key>
                <string>storage.type.horizon</string>
            </dict>
            <dict>
                <key>match</key>
                <string>(?i)(?&lt;![\w-])(?:LOG-TRIANGULAR|LOG-UNIFORM|TRIANGULAR|UNIFORM|DISCRETE|LHS|MC|MINIMUM|MAXIMUM|TRUE|FALSE)(?![\w-])</string>
                <key>name</key>
                <string>constant.language.horizon</string>
            </dict>
            <dict>
                <key>match</key>
                <string>[{}]</string>
                <key>name</key>
                <string>punctuation.section.braces.horizon</string>
            </dict>
            <dict>
                <key>match</key>
                <string>\(|\)</string>
                <key>name</key>
                <string>punctuation.section.parens.horizon</string>
            </dict>
            <dict>
                <key>match</key>
                <string>=</string>
                <key>name</key>
                <string>keyword.operator.assignment.horizon</string>
            </dict>
        </array>
    </dict>
</plist>
