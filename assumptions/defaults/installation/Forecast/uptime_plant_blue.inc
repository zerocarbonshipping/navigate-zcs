# Description: Fraction of a year a blue plant is operating.
# Unit: Fraction

Forecast "uptime_plant_blue" {
    Table = [
        "01-01-2025"    0.913   # 8000 hours per year
        "01-01-2050"    0.913   # 8000 hours per year
    ]
}
