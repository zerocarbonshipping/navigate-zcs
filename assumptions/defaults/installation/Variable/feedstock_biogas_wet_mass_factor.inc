# Description: Wet mass moved by truck per dry mass of biogas feedstock (manure and other wet organics).
#              The feed mass of the biogas plants is in dry tonnes; the truck moves wet tonnes.
# Unit: wet ton / dry ton

Variable "feedstock_biogas_wet_mass_factor" {
	Value = 1.0
}
