# DEMO - the Horizon study of the leadership demo: the mid regulation reference
# scenario over eight of notebook 2's levers at once, each drawn from notebook
# 2's suggested span as a multiplier on what the deck says (1.0 = the reference).
#
# Sample 1 takes every lever at its most likely value, sample 2 at the end that
# lowers emissions and sample 3 at the other end; the rest are a Latin hypercube.

# markets
ContinuousParameter "OIL_PRICE"                  = TRIANGULAR(0.6, 1.0, 2.0) { active = TRUE,  emissions_low = MAXIMUM }
ContinuousParameter "LNG_PRICE"                  = TRIANGULAR(0.6, 1.0, 2.0) { active = TRUE,  emissions_low = MAXIMUM }
ContinuousParameter "EFUEL_ELECTRICITY_PRICE"    = TRIANGULAR(0.6, 1.0, 1.4) { active = TRUE }
ContinuousParameter "BIOMASS_SHARE_FOR_SHIPPING" = TRIANGULAR(0.5, 1.0, 3.0) { active = TRUE,  emissions_low = MAXIMUM }
ContinuousParameter "TRADE_GROWTH"               = TRIANGULAR(0.0, 1.0, 2.0) { active = TRUE }

# policy
ContinuousParameter "EU_ETS_PRICE"               = TRIANGULAR(0.5, 1.0, 3.0) { active = TRUE,  emissions_low = MAXIMUM }
ContinuousParameter "GLOBAL_STANDARD_TARGET"     = TRIANGULAR(0.5, 1.0, 1.2) { active = TRUE }
ContinuousParameter "GLOBAL_STANDARD_PENALTY"    = TRIANGULAR(0.0, 1.0, 5.0) { active = TRUE,  emissions_low = MAXIMUM }

# held at the reference
ContinuousParameter "FUELEU_TARGET"              = TRIANGULAR(0.3, 1.0, 1.2) { active = FALSE }
ContinuousParameter "FUELEU_PENALTY"             = TRIANGULAR(1.0, 1.0, 5.0) { active = FALSE, emissions_low = MAXIMUM }
ContinuousParameter "BIOGENIC_CO2_AVAILABILITY"  = TRIANGULAR(0.5, 1.0, 2.0) { active = FALSE, emissions_low = MAXIMUM }
ContinuousParameter "PLANT_BUILD_LIMIT"          = TRIANGULAR(0.5, 1.0, 3.0) { active = FALSE, emissions_low = MAXIMUM }
ScenarioParameter "NO_EU_ETS"          { values = ["0", "1"], default = "0", active = FALSE }
ScenarioParameter "NO_FUELEU"          { values = ["0", "1"], default = "0", active = FALSE }
ScenarioParameter "NO_GLOBAL_STANDARD" { values = ["0", "1"], default = "0", active = FALSE }
ScenarioParameter "EU_RULES_WORLDWIDE" { values = ["0", "1"], default = "0", active = FALSE }
ScenarioParameter "FREEZE_EFFICIENCY"  { values = ["0", "1"], default = "0", active = FALSE }
ScenarioParameter "GRID" { values = ["coarse", "yearly"], default = "coarse", active = FALSE }

Horizon {
    UncFilePath = "basecase_mid_regulation.unc"
    OutputPath = "study"
    NumberOfSamples = 100
    SamplingMethod = LHS
    RandomSeed = 42
}
